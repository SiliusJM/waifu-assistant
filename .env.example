# Copiar a .env solo para desarrollo local. Nunca versionar .env.
APP_ENV=development
LOG_LEVEL=info

# Phase 1 usa mock por defecto; direct requiere completar las variables.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
AI_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=100
AI_RETRY_MAX_DELAY_MS=1000

# OmniRoute queda desactivado y fuera del alcance de Phase 1.
OMNIROUTE_ENABLED=false
