# Copiar a .env solo para desarrollo local. Nunca versionar .env.
APP_ENV=development
LOG_LEVEL=info

# Mock es el valor seguro por defecto; direct requiere completar las variables.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
AI_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=100
AI_RETRY_MAX_DELAY_MS=1000

# Opcional: omniroute | groq | gemini | openrouter. Vacío conserva legacy/mock.
# Un perfil requiere su propio MODEL y API_KEY; no hereda AI_MODEL/AI_API_KEY.
# BASE_URL vacío usa el endpoint incorporado. AI_TIMEOUT_MS/retries son globales.
AI_PROVIDER_PROFILE=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GEMINI_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
